        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>URL (http/https) atau path file lokal foto candi. Jika diisi, menimpa foto dari Wikipedia.</rdfs:comment>
    </owl:DatatypeProperty>

