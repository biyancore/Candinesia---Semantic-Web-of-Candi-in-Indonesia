        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Judul artikel Wikipedia untuk mengambil foto otomatis. Boleh berawalan kode bahasa, mis. id:Candi_Sukuh (default: en).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/candi-indonesia#fotoCandi">
